{
  "name": "bumi-digital-mcp",
  "version": "1.0.0",
  "description": "MCP server for Bumi Digital API — AI image, video, audio generation & upscaling for Claude, Cursor, and Trae",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "bumi-digital-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "dev": "tsc && node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "bumi-digital",
    "ai",
    "image-generation",
    "video-generation",
    "audio-generation",
    "upscale"
  ],
  "homepage": "https://github.com/ezmakeai/bumi-digital-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ezmakeai/bumi-digital-mcp.git"
  },
  "bugs": "https://github.com/ezmakeai/bumi-digital-mcp/issues",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.50",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18"
  }
}
